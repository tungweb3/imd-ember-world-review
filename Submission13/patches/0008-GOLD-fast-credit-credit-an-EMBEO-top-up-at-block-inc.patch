+  assert.deepEqual(s.history.map(h=>[h.kind,h.delta]).sort(),[['fast-revert','-10'],['topup','10']]);
+  assert.deepEqual(await f.fast(id,tx),{status:'reverted'});assert.equal((await f.maintain()).reverted,0);f.balanced();
+}finally{f.close();}});
