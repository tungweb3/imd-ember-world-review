+  ...take>0n?[st(db,`INSERT INTO world_gold_fast_entries(id,wallet,delta,kind,reference,order_id,created_ms) VALUES(?,?,?,'fast-revert',?,?,?)`,'fast-revert:'+c.order_id,c.wallet,-take,'fast-revert:'+c.order_id,c.order_id,nowMs)]:[],
+  ...owed>0n?[st(db,'INSERT INTO world_gold_fast_debts(order_id,wallet,amount,created_ms) VALUES(?,?,?,?)',c.order_id,c.wallet,owed,nowMs)]:[],
