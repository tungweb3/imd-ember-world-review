+  st(db,`INSERT INTO world_gold_fast_entries(id,wallet,delta,kind,reference,order_id,created_ms) VALUES(?,?,?,'fast-topup',?,?,?)`,'fast-topup:'+orderId,wallet,BigInt(row!.gold),'fast-topup:'+orderId,orderId,now),
