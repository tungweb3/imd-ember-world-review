+  await f.spend();assert.equal((await f.snapshot()).book,'4','spending is open again');f.balanced();
+  assert.throws(()=>f.db.raw.exec('UPDATE world_gold_fast_debts SET amount=0'),/INVALID_FAST_DEBT_TRANSITION/);
+}finally{f.close();}});
