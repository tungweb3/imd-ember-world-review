+/** Fast GOLD credit (server/world-gold-fast.ts): the finalized indexer's own log, receipt and header parsing applied to
+ *  one server-fetched receipt. The browser supplies only the hash to look up. Returns the single Paid event for
+ *  `orderId` when its block is the canonical one at that height, or null while the transaction is not mined or its
+ *  block is not canonical (yet). This is inclusion, not finality: callers keep it out of the finalized ledger. */
+export async function economyReceiptPayment(config:EconomyConfig,rpc:EconomyRpc,transactionHash:string,orderId:string):Promise<EconomyChainEvent|null>{
+  const tx=hash(transactionHash),order=hash(orderId);
+  if(quantity(await rpc('eth_chainId',[]))!==1n)return fail('WRONG_CHAIN');
+  const raw=await rpc('eth_getTransactionReceipt',[tx]);if(raw===null)return null;
+  const receipt=object(raw);
+  if(hash(receipt.transactionHash)!==tx)return fail('RECEIPT_SOURCE_MISMATCH');
+  if(quantity(receipt.status)!==1n)return fail('TRANSACTION_FAILED');
+  const number=quantity(receipt.blockNumber),blockHash=hash(receipt.blockHash);
+  const header=block(await rpc('eth_getBlockByNumber',[hex(number),false]),number);
+  if(header.hash!==blockHash)return null;
+  if(!Array.isArray(receipt.logs))return fail('MALFORMED_RECEIPT_LOGS');
+  const matches:EconomyChainEvent[]=[];
+  for(const candidate of receipt.logs){
+    const c=object(candidate),l=log({...c,removed:c.removed??false});   // receipts may omit `removed`; a removed log is still refused
+    if(l.address!==config.paymentContract||l.topics[0]!==ECONOMY_EVENT_TOPICS.payment)continue;
+    if(l.transactionHash!==tx||l.blockNumber!==number||l.blockHash!==blockHash)return fail('RECEIPT_LOG_MISMATCH');
+    const e=decode(config,l,header.timestamp);if(e.orderId===order)matches.push(e);
+  }
+  return matches.length===1?matches[0]:fail(matches.length?'DUPLICATE_ORDER_PAYMENT':'NO_PAYMENT_FOR_ORDER');
+}
