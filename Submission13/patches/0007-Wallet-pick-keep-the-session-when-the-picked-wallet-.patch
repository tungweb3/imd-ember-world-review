@@ -137,6 +137,8 @@ export class AuthClient{
   private bound:Provider|null=null;private binds=0;private accountEvents=0;
   /** A cookie is not a wallet observation. Keep the last observed account across a lock, within this page's binding. */
   private observedAccount:string|null=null;
+  /** The explicit wallet pick whose eth_accounts reply is awaited; any newer pick or a return to the bound one drops it. */
+  private picking:object|null=null;
   /** The newest session read: a click waits until none is running, so a reload with a live cookie never asks for a signature. */
   private restoring:Promise<void>|null=null;private deps:AuthDeps;
   /** N-1: numbers every session read; only the newest one's answer, failure or body is applied (one overtaken by a newer
@@ -320,10 +322,14 @@ export class AuthClient{
     if(p.on){const h=(v:unknown)=>{if(b===this.binds)this.accountChanged(firstAccount(v));};p.on('accountsChanged',h);this.unsub=()=>p.removeListener?.('accountsChanged',h);}
   }
   /** Passive provider replacement is rebind/reconcile only until eth_accounts proves a different address. An explicit
-   *  wallet pick remains a context switch, even for the same address. SIWE is fixed to chain 1; wallet chain events do
-   *  not expand that existing policy or add wallet methods. */
+   *  wallet pick is a context switch unless the picked wallet's already-granted account (eth_accounts, never a prompt)
+   *  is the signed-in address while no sign-in or retained flow is in progress: then the session stays and only the
+   *  transport changes. A locked wallet, an empty or failed reply, another address or any intervening event switches
+   *  as before. SIWE is fixed to chain 1; wallet chain events do not expand that existing policy or add wallet methods. */
   providerChanged(reason:ProviderChangeReason='discovery'){
-    const p=this.deps.provider();if(p===this.bound)return;
+    const p=this.deps.provider();
+    if(p===this.bound){if(this.picking){this.picking=null;this.set({account:this.observedAccount,checking:false});}return;}
+    this.picking=null;
     const abandoned=this.lifecycle.click,held=this.s.session??undefined;
     if(reason==='discovery'){
       const account=this.observedAccount,currentOwners=this.lifecycle.retainedOwners.filter(owner=>owner.life===this.life);
@@ -334,6 +340,22 @@ export class AuthClient{
       }else this.set({account:null});
       this.bind(p,true,account);return;
     }
+    if(p&&held&&!abandoned&&!this.lifecycle.retainedOwners.some(owner=>owner.life===this.life)){
+      const pick={},g=this.gen,life=this.life,e=this.accountEvents;this.picking=pick;
+      this.set({account:null,checking:true});
+      void p.request({method:'eth_accounts'}).then(firstAccount,()=>null).then(a=>{
+        if(this.picking!==pick||life!==this.life||this.deps.provider()!==p)return;this.picking=null;
+        if(a&&g===this.gen&&e===this.accountEvents&&!this.lifecycle.click&&a===this.s.session?.address){
+          this.observedAccount=a;this.set({checking:false});this.bind(p,true,a);return;}
+        this.switchProvider(p);
+      });
+      return;
+    }
+    this.switchProvider(p);
+  }
+  /** An explicit pick of another wallet identity: every flow of the old one ends and its session is cleaned up. */
+  private switchProvider(p:Provider|null){
+    const abandoned=this.lifecycle.click,held=this.s.session??undefined;
     this.gen++;this.lifecycle.cancel();this.cancelOwners('context-switch');
     this.set({account:null,phase:'idle',waiting:false,notice:null,sessionKnown:false,home:null,checking:false});
     this.automaticCleanup('provider-switch',this.gen,this.life,abandoned,held);
