+// 2026-10-26 owner decision: picking another wallet that already grants the signed-in address keeps the session (the
+// owner with two wallet extensions was signed out on every pick). Only the transport changes; nothing is signed or revoked.
+test('explicit pick of another wallet with the signed-in address keeps the session and follows only the new wallet',async t=>{
+  const w=setup(),A=newAccount(),b=w.browser(),first=provider(A),second=provider(A),reg=registry(null);
+  reg.announce(first);reg.announce(second,'two');reg.r.choose(reg.r.state.options[0]);
+  assert.equal((await b.signIn(A)).verify.status,200);
+  const q=tab(w,b,first,{getProvider:()=>reg.r.current()}),off=reg.r.subscribeProvider(reason=>q.notifyProvider(reason));
+  try{
+    await ready(q);const accepted=q.c.state.session;
+    reg.r.choose(reg.r.state.options.find(o=>o.provider===second));
+    await until(()=>q.c.state.account===A.address.toLowerCase()&&!q.c.state.checking);await flush(20);record(t,'same-address pick',q,[first,second]);
+    assert.equal(logouts(q).length,0,'no cleanup for the same address');
+    assert.deepEqual([rows(w).counts.created,rows(w).counts.live,rows(w).counts.revoked],[1,1,0]);
+    assert.deepEqual(q.c.state.session,accepted);assert.equal((await (await b.get('/api/auth/session')).json()).signedIn,true);
+    assert.ok(second.calls.length>0&&second.calls.every(m=>m==='eth_accounts'),'the picked wallet is only read silently');
+    assert.equal(prompts([first,second]),0);assert.equal(routeEvents(q,'/api/auth/challenge').length,0);
+    const before=first.calls.length;await q.signIn();await flush();
+    assert.equal(first.calls.length,before,'the previous wallet is no longer asked anything');
+  }finally{off();reg.stop();q.stop();}
+});
+
+for(const mode of ['locked','other-address'])test(`explicit pick of a wallet that is ${mode} still switches and cleans the old session`,async t=>{
+  const w=setup(),A=newAccount(),B=newAccount(),b=w.browser(),first=provider(A),second=provider(mode==='locked'?null:B),reg=registry(null);
+  reg.announce(first);reg.announce(second,'two');reg.r.choose(reg.r.state.options[0]);
+  assert.equal((await b.signIn(A)).verify.status,200);
+  const q=tab(w,b,first,{getProvider:()=>reg.r.current()}),off=reg.r.subscribeProvider(reason=>q.notifyProvider(reason));
+  try{
+    await ready(q);reg.r.choose(reg.r.state.options.find(o=>o.provider===second));
+    await until(()=>rows(w).counts.revoked===1&&!q.c.state.session&&!q.c.state.checking);record(t,mode,q,[first,second]);
+    assert.equal(logouts(q).length,1);assert.equal(q.c.lifecycleSnapshot.cleanupPlans.at(-1).reason,'provider-switch');
+    assert.equal(q.c.state.account,mode==='locked'?null:B.address.toLowerCase());assert.equal(prompts([first,second]),0);
+  }finally{off();reg.stop();q.stop();}
+});
+
+test('a pick reverted before the picked wallet answers changes nothing',async t=>{
+  const w=setup(),A=newAccount(),B=newAccount(),b=w.browser(),first=provider(A),second=provider(B),reg=registry(null);
+  const reply=defer(),request=second.request;second.request=async a=>{if(a.method==='eth_accounts')await reply.promise;return request(a);};
+  reg.announce(first);reg.announce(second,'two');reg.r.choose(reg.r.state.options[0]);
+  assert.equal((await b.signIn(A)).verify.status,200);
+  const q=tab(w,b,first,{getProvider:()=>reg.r.current()}),off=reg.r.subscribeProvider(reason=>q.notifyProvider(reason));
+  try{
+    await ready(q);const accepted=q.c.state.session;
+    reg.r.choose(reg.r.state.options.find(o=>o.provider===second));await flush();assert.equal(q.c.state.checking,true);
+    reg.r.choose(reg.r.state.options.find(o=>o.provider===first));await flush();
+    assert.equal(q.c.state.checking,false);assert.equal(q.c.state.account,A.address.toLowerCase());
+    reply.resolve();await flush(20);record(t,'reverted pick',q,[first,second]);
+    assert.equal(logouts(q).length,0);assert.deepEqual(q.c.state.session,accepted);
+    assert.deepEqual([rows(w).counts.created,rows(w).counts.live,rows(w).counts.revoked],[1,1,0]);
+  }finally{off();reg.stop();q.stop();}
+});
+
 test('Audit1 passive first provider with a different account cannot revoke a cookie-restored session without an established wallet account',async t=>{
   const w=setup(),A=newAccount(),B=newAccount(),b=w.browser(),p=provider(B),reg=registry(null);
   assert.equal((await b.signIn(A)).verify.status,200);
