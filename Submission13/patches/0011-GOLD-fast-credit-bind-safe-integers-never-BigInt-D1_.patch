 const transient=(e:unknown)=>e instanceof Error&&/^(ECONOMY_RPC_UNAVAILABLE|ECONOMY_RPC_RATE_LIMITED|ECONOMY_SYNC_TIMEOUT|RPC_RESULT_LIMIT)$/.test(e instanceof EconomyRpcError?e.code:e.message);
