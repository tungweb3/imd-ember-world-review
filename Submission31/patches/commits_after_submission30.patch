--- a/server/squeek-store.ts
+++ b/server/squeek-store.ts
@@ -40,12 +40,16 @@ function config(deps:SqueekDeps):Config|null{
  }catch{return null;}
 }
 function clock(deps:SqueekDeps){const n=(deps.now??Date.now)();if(!Number.isSafeInteger(n)||n<=0)throw Error('INVALID_CLOCK');return n;}
-async function body(request:Request,keys:readonly string[]):Promise<Record<string,unknown>|null>{
- if(!/^application\/json\s*(;|$)/i.test(request.headers.get('content-type')??'')||Number(request.headers.get('content-length'))>2048||!request.body)return null;
+const JSON_TYPE=/^application\/json\s*(;|$)/i;
+const exact=(v:Record<string,unknown>|null,keys:readonly string[])=>v&&Object.keys(v).length===keys.length&&keys.every(k=>Object.hasOwn(v,k))?v:null;
+async function body(request:Request,keys:readonly string[]):Promise<Record<string,unknown>|null>{return exact(await json(request),keys);}
+/** At most 2048 bytes of a JSON object. anyType: read it whatever the Content-Type says (the token route decides afterwards). */
+async function json(request:Request,anyType=false):Promise<Record<string,unknown>|null>{
+ if(!anyType&&!JSON_TYPE.test(request.headers.get('content-type')??'')||Number(request.headers.get('content-length'))>2048||!request.body)return null;
  const reader=request.body.getReader(),chunks:Uint8Array[]=[];let length=0;
  for(;;){const r=await reader.read();if(r.done)break;length+=r.value.byteLength;if(length>2048){await reader.cancel().catch(()=>{});return null;}chunks.push(r.value);}
  const bytes=new Uint8Array(length);let at=0;for(const c of chunks){bytes.set(c,at);at+=c.length;}
- try{const v=JSON.parse(new TextDecoder('utf-8',{fatal:true}).decode(bytes));return v&&typeof v==='object'&&!Array.isArray(v)&&Object.keys(v).length===keys.length&&keys.every(k=>Object.hasOwn(v,k))?v:null;}catch{return null;}
+ try{const v=JSON.parse(new TextDecoder('utf-8',{fatal:true}).decode(bytes));return v&&typeof v==='object'&&!Array.isArray(v)?v:null;}catch{return null;}
 }
 /** The game sees a stable pseudonym and no part of the wallet address. It is an HMAC under a Worker secret, so it cannot be
  * computed from an address list. The key must never be rotated: every subject id would change. */
@@ -124,13 +128,18 @@ async function authorize(request:Request,url:URL,deps:SqueekDeps,cfg:Config,db:D
  if(!row)return reply(401,{error:'AUTH_REQUIRED'});
  const target=new URL(cfg.redirect);target.searchParams.set('world_code',code);target.searchParams.set('world_state',q.state);return reply(303,null,{Location:target.href});
 }
-async function token(request:Request,deps:SqueekDeps,cfg:Config,db:D1Database,headers:Record<string,string>){
+/** A code presented again after it was used means it leaked: revoke the grant issued on it (RFC 6749 4.1.2). */
+const revokeReused=(db:D1Database,now:number,hash:string)=>db.prepare(`UPDATE squeek_tokens SET revoked_at=?1 WHERE revoked_at IS NULL AND token_hash=(SELECT token_hash FROM squeek_auth_codes WHERE code_hash=?2 AND token_hash<>'rejected')`).bind(now,hash).run();
+async function token(request:Request,deps:SqueekDeps,cfg:Config,db:D1Database,headers:Record<string,string>,search:boolean){
  // Per client first: a caller-chosen code must not open a fresh budget.
  if(!await deps.allow!('squeek:token-client:'+(deps.client??'unknown')))return reply(429,{error:'RATE_LIMITED'},{...headers,'Retry-After':'60'});
- const b=await body(request,['grant_type','client_id','redirect_uri','code','code_verifier']);
+ const raw=await json(request,true),b=!search&&JSON_TYPE.test(request.headers.get('content-type')??'')?exact(raw,['grant_type','client_id','redirect_uri','code','code_verifier']):null;
  if(!b||b.grant_type!=='authorization_code'||b.client_id!==SQUEEK_CLIENT_ID||b.redirect_uri!==cfg.redirect||typeof b.code!=='string'||!OPAQUE.test(b.code)||typeof b.code_verifier!=='string'||!OPAQUE.test(b.code_verifier)){
-  // A well-formed code that arrives with anything else wrong is spent as well: one attempt per code.
-  if(b&&typeof b.code==='string'&&OPAQUE.test(b.code))await db.prepare(`UPDATE squeek_auth_codes SET consumed_at=?1,token_hash='rejected' WHERE code_hash=?2 AND consumed_at IS NULL`).bind(clock(deps),await sha256(b.code)).run();
+  // A well-formed code that arrives with anything else wrong (fields, key set, content type, query string) is spent as
+  // well: one attempt per code. If it was already used, the grant issued on it is revoked, as on the main path.
+  if(raw&&typeof raw.code==='string'&&OPAQUE.test(raw.code)){const n=clock(deps),h=await sha256(raw.code);
+   const spent=await db.prepare(`UPDATE squeek_auth_codes SET consumed_at=?1,token_hash='rejected' WHERE code_hash=?2 AND consumed_at IS NULL`).bind(n,h).run();
+   if(!Number(spent.meta?.changes))await revokeReused(db,n,h);}
   return reply(400,{error:'BAD_REQUEST'},headers);
  }
  const [hash,challenge]=await Promise.all([sha256(b.code),squeekPkce(b.code_verifier)]);
@@ -148,8 +157,7 @@ async function token(request:Request,deps:SqueekDeps,cfg:Config,db:D1Database,he
    .bind(now,now+SQUEEK_TOKEN_TTL_MS,hash,grantHash)
  ]);
  const row=rows[1]?.results[0] as {address:string;expires_at:number}|undefined;
- // A code presented again after it was used means it leaked: revoke the grant issued on it (RFC 6749 4.1.2).
- if(rows[0]?.results.length===0)await db.prepare(`UPDATE squeek_tokens SET revoked_at=?1 WHERE revoked_at IS NULL AND token_hash=(SELECT token_hash FROM squeek_auth_codes WHERE code_hash=?2 AND token_hash<>'rejected')`).bind(now,hash).run();
+ if(rows[0]?.results.length===0)await revokeReused(db,now,hash);
  if(rows[0]?.results.length!==1||(rows[0].results[0] as {token_hash:string}).token_hash!==grantHash||!row)return reply(401,{error:'INVALID_GRANT'},headers);
  return reply(200,{token_type:'Bearer',access_token:grant,scope:'squeek:read',expires_at:row.expires_at,subject_id:await squeekSubject(cfg.subjectKey,row.address)},headers);
 }
@@ -214,7 +222,7 @@ export async function handleSqueek(request:Request,deps:SqueekDeps):Promise<Resp
  try{
   if(route==='catalog'){if(url.search)return reply(400,{error:'BAD_REQUEST'},cors);if(!await deps.allow('squeek:catalog:'+(deps.client??'unknown')))return reply(429,{error:'RATE_LIMITED'},cors);
    return reply(200,{catalogVersion:SQUEEK_CATALOG_VERSION,salesEnabled:await salesOpen(db,deps),items:SQUEEK_ITEMS.map(item)},cors);}
-  if(route==='token'){if(url.search)return reply(400,{error:'BAD_REQUEST'},cors);return await token(request,deps,cfg,db,cors);}
+  if(route==='token')return await token(request,deps,cfg,db,cors,url.search!=='');
   const tokenValue=bearer(request);if(!tokenValue)return reply(401,{error:'AUTH_REQUIRED'},{...cors,'WWW-Authenticate':'Bearer'});
   // Both budgets before any database read: per client (a fresh random token must not open a new one), then per grant.
   if(!await (deps.allowClient??deps.allow)('squeek:api-client:'+(deps.client??'unknown'))||!await deps.allow('squeek:api:'+(await sha256(tokenValue)).slice(0,32)))return reply(429,{error:'RATE_LIMITED'},{...cors,'Retry-After':'60'});
@@ -242,7 +250,8 @@ export async function handleSqueek(request:Request,deps:SqueekDeps):Promise<Resp
 export async function pruneSqueekAuth(db:D1Database,now:number){
  if(!Number.isSafeInteger(now)||now<0)throw Error('INVALID_CLOCK');
  const [codes,tokens]=await db.batch([
-  db.prepare('DELETE FROM squeek_auth_codes WHERE code_hash IN (SELECT code_hash FROM squeek_auth_codes WHERE expires_at<=?1 ORDER BY expires_at LIMIT 200)').bind(now),
+  // A code row is kept until every grant made from it has expired, so a replayed code can still revoke its grant.
+  db.prepare('DELETE FROM squeek_auth_codes WHERE code_hash IN (SELECT code_hash FROM squeek_auth_codes WHERE expires_at<=?1 ORDER BY expires_at LIMIT 200)').bind(now-SQUEEK_TOKEN_TTL_MS),
   db.prepare('DELETE FROM squeek_tokens WHERE token_hash IN (SELECT token_hash FROM squeek_tokens WHERE expires_at<=?1 ORDER BY expires_at LIMIT 200)').bind(now)
  ]);return {codes:Number(codes.meta.changes??0),tokens:Number(tokens.meta.changes??0)};
 }
