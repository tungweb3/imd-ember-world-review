@@ -296,3 +298,29 @@ test('85163d96 #6: the checkout page shows ALREADY_OWNED instead of a payment bu
  assert.match(page,/throw Error\('CONTEXT_CHANGED'\);if\(latest\.owned\)throw Error\('ALREADY_OWNED'\);const order=squeekEconomyOrder/);
  assert.match(page,/\{status\?<p role="status">\{status\}<\/p>:data\.owned\?<p role="status">\{ERRORS\.ALREADY_OWNED\[zh\?0:1\]\}<\/p>:order\.expiresAt/);
