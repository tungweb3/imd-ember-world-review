+
+// ---- Audit 48111df0 ----
+test('48111df0 #1: any failed exchange that names a well-formed code spends it: extra or missing key, other content type, query string',async t=>{const f=await setup(t);
+ const body=extra=>({grant_type:'authorization_code',client_id:'squeek-ascension',redirect_uri:REDIRECT,code_verifier:VERIFIER,...extra});
+ const send=(code,{json=body({code}),type='application/json',path='token'}={})=>f.call(path,{method:'POST',headers:{origin:GAME,'content-type':type},body:json});
+ const cases=[c=>send(c,{json:body({code:c,extra:1})}),c=>{const j=body({code:c});delete j.code_verifier;return send(c,{json:j});},c=>send(c,{type:'text/plain'}),c=>send(c,{path:'token?x=1'})];
+ for(const [i,attempt] of cases.entries()){const code=await mintCode(f);
+  assert.equal((await attempt(code)).status,400,'case '+i);assert.equal((await exchangeCode(f,code)).status,401,'case '+i);
+  assert.equal(f.db.raw.prepare('SELECT token_hash FROM squeek_auth_codes WHERE code_hash=?').get(await sha256(code)).token_hash,'rejected');}
+ assert.equal(f.db.raw.prepare('SELECT count(*) n FROM squeek_tokens').get().n,0);
+});
+
+test('48111df0 #2: a used code replayed with any field wrong revokes its grant too',async t=>{const f=await setup(t);
+ for(const patch of [{client_id:'celestao'},{redirect_uri:REDIRECT+'x'},{code_verifier:'short'}]){
+  const code=await mintCode(f),grant=(await (await exchangeCode(f,code)).json()).access_token;assert.equal((await f.api(grant,'snapshot')).status,200);
+  assert.equal((await exchangeCode(f,code,patch)).status,400);assert.equal((await f.api(grant,'snapshot')).status,401,JSON.stringify(patch));}
+ const other=await f.login(),bad=await mintCode(f);assert.equal((await exchangeCode(f,bad,{client_id:'celestao'})).status,400);assert.equal((await exchangeCode(f,bad,{client_id:'celestao'})).status,400);
+ assert.equal((await f.api(other,'snapshot')).status,200,'a code spent by mistake revokes nothing');
+});
+
+test('48111df0 #3: a replay revokes the grant for its whole lifetime, also after the quarter-hour prune',async t=>{const f=await setup(t);
+ const code=await mintCode(f),grant=(await (await exchangeCode(f,code)).json()).access_token;
+ const late=NOW+59*60000;assert.deepEqual(await pruneSqueekAuth(f.db,late),{codes:0,tokens:0});
+ assert.equal((await f.call('token',{method:'POST',headers:{origin:GAME},body:{grant_type:'authorization_code',client_id:'squeek-ascension',redirect_uri:REDIRECT,code,code_verifier:VERIFIER},deps:{now:()=>late}})).status,401);
+ assert.equal((await f.call('snapshot',{headers:{origin:GAME,authorization:'Bearer '+grant},deps:{now:()=>late}})).status,401);
+});
