+import type {Plugin} from 'vite';
+import {mkdirSync} from 'node:fs';
+import {resolve} from 'node:path';
+import {LocalCollectionStore} from './collection-local-store.ts';
+import {createCollectionLocalApi} from './collection-local-api.ts';
+
+// Dev only, explicit opt-in, loopback only. Never installed on the Worker or vite preview.
+export function collectionLocalPlugin():Plugin{
+  return {name:'ember-collection-local',apply:'serve',configureServer(server){
+    if(process.env.EMBER_COLLECTION_LOCAL!=='1')return;
+    const dir=resolve(server.config.root,'.local-collection');mkdirSync(dir,{recursive:true});
+    const store=new LocalCollectionStore(resolve(dir,'collections.sqlite')),api=createCollectionLocalApi(store);
+    server.httpServer?.once('close',()=>store.close());
+    server.middlewares.use(async(req,res,next)=>{
+      if(!req.url?.startsWith('/api/local-collection/'))return next();
+      const host=req.headers.host??'';
+      if(!/^((127\.0\.0\.1)|(localhost)|(\[::1\])):\d+$/.test(host)){res.statusCode=403;return res.end('Local only');}
+      const chunks:Buffer[]=[];let bytes=0;
+      for await(const chunk of req){bytes+=Buffer.byteLength(chunk);if(bytes>4096){res.statusCode=413;return res.end('Body too large');}chunks.push(Buffer.from(chunk));}
+      const headers=new Headers();for(const [k,v] of Object.entries(req.headers))if(v!==undefined)headers.set(k,Array.isArray(v)?v.join(','):v);
+      const method=req.method??'GET',response=await api(new Request(`http://${host}${req.url}`,{method,headers,...method==='POST'?{body:Buffer.concat(chunks).toString()}: {}}));
+      if(!response)return next();res.statusCode=response.status;response.headers.forEach((v,k)=>res.setHeader(k,v));res.end(await response.text());
+    });
+  }};
+}
