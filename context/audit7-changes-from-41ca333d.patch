+  "collisionCode": "import {LANDMARKS,WALLS,DECOR_SOLIDS,HOME_COLLIDER,STOP_POSTS,SHELTERS,shelterBox,LONGHOUSE_SOLID,FORGE_SOLID,FORGE_YARD_PROPS,inBox,inWater,inWorld,launchSolids,type HomePose,type Point} from './layout.ts';\nimport {OBSERVATORY} from './market.ts';\nimport {decorPosts,POST_FOOT,type Post} from './pepeDecor.ts';\nimport {PLINTH,PEPE_SCALE} from './pepeStatue.ts';\nimport {CABLE_SOLIDS} from './cableCar.ts';\n\n// The walking rule for Emberford. scene.ts calls blockedAt() for every step and the map tests call the same\n// function, so a moved landmark, wall or river bend is checked by exactly the rule the player walks under.\nexport type Box={x:number;z:number;hw:number;hd:number;rotation:number};\nexport const LANDMARK_PAD=.35;\nexport const OBSERVATORY_BOX:Box={x:OBSERVATORY.x,z:OBSERVATORY.z,hw:5.7,hd:2.4,rotation:OBSERVATORY.rotation};\n/** Pepe's plinth's foot as drawn (pepeStatue.ts PLINTH, in the Pepe group's units, drawn PEPE_SCALE times). */\nexport const PEPE_RADIUS=PLINTH.foot*PEPE_SCALE;\nlet posts:Post[]|null=null;\n/** The $1B beacon's footing on the launch pier (a boat stop since 2026-09-30), and the lamp and sign left at a stop\n *  (layout.ts STOP_POSTS): their feet, 0.44 m square. */\nconst LAUNCH_SOLIDS=launchSolids(),STOP_FOOT={hw:.22,hd:.22};\nconst LONGHOUSE_WALL=WALLS.find(w=>w.id===LONGHOUSE_SOLID.id);\n/** The forge's yard (layout.ts FORGE_YARD_PROPS, 2026-10-01): its woodpile, crates, cart, anvil, trough and charcoal heap\n *  (its ash tree is not solid, as the forest's are not). */\nconst YARD_SOLIDS=FORGE_YARD_PROPS.filter(q=>q.kind!=='ash');\nconst STOP_SOLIDS=STOP_POSTS.map(q=>({id:'stop-'+q.kind,x:q.x,z:q.z,...STOP_FOOT,rotation:q.facing*180/Math.PI}));\n/** The stops' boat shelters (layout.ts SHELTERS, 2026-10-02): solid, their whole box, its lantern and eaves too. */\nconst SHELTER_SOLIDS=SHELTERS.map(shelterBox);\nexport function homeBox(p:HomePose):Box{return {x:p.x,z:p.z,...HOME_COLLIDER,rotation:p.rotation*180/Math.PI};}\n/** Name of whatever stops the player at p, or null when p is open ground. */\nexport function blockedAt(p:Point,homes:readonly Box[]=[],retiredCablePylons:boolean|'all'=false):string|null{\n  for(const b of LANDMARKS)if(Math.hypot(p.x-b.x,p.z-b.z)<b.radius+LANDMARK_PAD)return b.id;\n  if(inBox(FORGE_SOLID,p.x,p.z,.3))return 'forge';   // the grown forge's plinth, its corners past its circle (2026-10-01)\n  if(inBox(OBSERVATORY_BOX,p.x,p.z))return 'observatory';\n  if(Math.hypot(p.x-OBSERVATORY.pepe.x,p.z-OBSERVATORY.pepe.z)<PEPE_RADIUS)return 'pepe';\n  for(const w of WALLS)if(inBox(w===LONGHOUSE_WALL?LONGHOUSE_SOLID:w,p.x,p.z,.3))return w.id;   // Frosthollow's longhouse as it grew (2026-09-30)\n  for(const w of DECOR_SOLIDS)if(inBox(w,p.x,p.z,.3))return w.id;   // square pools, tree trunks, the Ember Belfry\n  for(const w of LAUNCH_SOLIDS)if(inBox(w,p.x,p.z,.3))return w.id;   // the $1B beacon's footing on the launch pier\n  for(const w of YARD_SOLIDS)if(inBox(w,p.x,p.z,.3))return w.id;   // the forge's yard\n  for(const w of CABLE_SOLIDS)if(retiredCablePylons!=='all'&&!(retiredCablePylons&&w.id.startsWith('cable-pylon-'))&&inBox(w,p.x,p.z,.3))return w.id;\n  for(const w of STOP_SOLIDS)if(Math.abs(p.x-w.x)<1&&Math.abs(p.z-w.z)<1&&inBox(w,p.x,p.z,.3))return w.id;   // 霜谷渡口's north-east landing's lamp and sign\n  for(const w of SHELTER_SOLIDS)if(Math.abs(p.x-w.x)<2.5&&Math.abs(p.z-w.z)<2.5&&inBox(w,p.x,p.z,.3))return w.id;   // the stops' shelters\n  for(const q of posts??=decorPosts())if(Math.abs(p.x-q.x)<POST_FOOT[q.kind]+.3&&Math.abs(p.z-q.z)<POST_FOOT[q.kind]+.3)return 'pepe-'+q.kind;   // the Pepe lamps' and gonfalons' feet\n  if(inWater(p.x,p.z))return 'water';\n  for(const h of homes)if(inBox(h,p.x,p.z))return 'home';\n  return null;\n}\n/** What stops a step: a solid (blockedAt: its padding is the player's reach) or the edge of the walkable world. */\nexport const walkBlocked=(homes:readonly Box[],bound:number,retiredCablePylons:boolean|'all'=false)=>(p:Point)=>blockedAt(p,homes,retiredCablePylons)!==null||!inWorld(p.x,p.z,bound);\n/** Metres a second: walking, and running with Shift. */\nexport const WALK_SPEED=5.2,RUN_SPEED=8.5;\n/** One frame under the keys or the stick: the input (x right, z back, as the stick reports it) turned by the camera's yaw,\n *  at most unit length, one step of `step` metres; into a solid it slides along whichever axis is still open. Moves hero\n *  in place; returns the heading and whether the step was blocked. */\nexport function walkStep(hero:Point,x:number,z:number,yaw:number,step:number,blocked:(p:Point)=>boolean){\n  let vx=x*Math.cos(yaw)+z*Math.sin(yaw),vz=-x*Math.sin(yaw)+z*Math.cos(yaw);const len=Math.hypot(vx,vz);if(len>1){vx/=len;vz/=len;}\n  const nx=hero.x+vx*step,nz=hero.z+vz*step,hit=blocked({x:nx,z:nz});\n  if(!hit){hero.x=nx;hero.z=nz;}else{if(!blocked({x:nx,z:hero.z}))hero.x=nx;if(!blocked({x:hero.x,z:nz}))hero.z=nz;}\n  return {vx,vz,hit};\n}\n\n// Tap-to-walk. There is no path planner: the player heads for the tapped point and, when a solid is in the way,\n// turns along it (15° steps up to 135°, keeping to the side it chose, so it can follow a wall that leans back) for\n// as long as that still brings it closer.\n// A tap on a solid itself (a pool, the plinth, a wall, the river) walks up to it, slides once and stops, as before.\nexport type Steer={x:number;z:number;vx:number;vz:number;side:number;best:number;stall:number;solid:boolean|null};\n/** Seconds of walking without getting 5 cm closer before a tap walk gives up (an unreachable spot, a dead end). */\nexport const STEER_STALL=1;\nconst TURNS=[15,30,45,60,75,90,105,120,135].map(d=>[Math.cos(d*Math.PI/180),Math.sin(d*Math.PI/180)] as const),STRAIGHT=[1,0] as const,STEP:Point={x:0,z:0};\nexport function steerTo(p:Point):Steer{return {x:p.x,z:p.z,vx:0,vz:0,side:0,best:Infinity,stall:0,solid:null};}\n/** One frame of a tap walk: moves `hero` in place by `step` metres toward `s` and leaves the heading in s.vx/s.vz.\n *  Returns false when the walk is over (arrived, stopped at the solid that was tapped, stuck or stalled). */\nexport function steerStep(hero:Point,s:Steer,step:number,dt:number,blocked:(p:Point)=>boolean):boolean{\n  const dx=s.x-hero.x,dz=s.z-hero.z,d=Math.hypot(dx,dz);s.vx=s.vz=0;\n  if(d<.3)return false;\n  s.solid??=blocked(s);\n  const ux=dx/d,uz=dz/d;\n  for(let k=0;k<=(s.solid?0:TURNS.length*2);k++){\n    // k = 0 heads straight; then the chosen side's turns, then the other side's (both sides alternate until one is chosen).\n    const sign=k===0?0:s.side?(k<=TURNS.length?s.side:-s.side):(k%2?1:-1),[c,sn]=k===0?STRAIGHT:TURNS[s.side?(k-1)%TURNS.length:(k-1)>>1];\n    const vx=ux*c-uz*sn*sign,vz=ux*sn*sign+uz*c;STEP.x=hero.x+vx*step;STEP.z=hero.z+vz*step;\n    if(blocked(STEP))continue;\n    hero.x=STEP.x;hero.z=STEP.z;s.vx=vx;s.vz=vz;if(sign)s.side=sign;\n    const nd=Math.hypot(s.x-hero.x,s.z-hero.z);\n    if(nd<s.best-.05){s.best=nd;s.stall=0;}else if((s.stall+=dt)>STEER_STALL)return false;\n    return true;\n  }\n  if(s.solid){STEP.x=hero.x+ux*step;STEP.z=hero.z;if(!blocked(STEP))hero.x=STEP.x;STEP.x=hero.x;STEP.z=hero.z+uz*step;if(!blocked(STEP))hero.z=STEP.z;}\n  return false;\n}\n",
