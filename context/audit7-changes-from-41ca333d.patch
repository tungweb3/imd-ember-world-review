@@ -0,0 +1,78 @@
+// Local collection candidate. No currency, mint authority or production wallet identifiers.
+export type Kind='weapon'|'armor'|'tool'|'trophy'|'nft';
+export type EquipSlot='weapon'|'armor'|'tool';
+export type DisplaySlot='trophy-1'|'trophy-2'|'weapon-1'|'weapon-2'|'armor-1'|'nft-1';
+export type NftState='owned'|'unavailable'|'transferred';
+export type HomeState='eligible'|'none'|'unavailable';
+export type Label={zh:string;en:string};
+export type Definition={id:string;kind:Kind;name:Label;description:Label;color:string};
+export const DEFINITIONS:readonly Definition[]=[
+  {id:'training-rifle',kind:'weapon',name:{zh:'訓練步槍',en:'Training rifle'},description:{zh:'本機基礎裝備；配裝設定尚未套用至正式對戰。',en:'Local starter equipment. Loadouts do not change live battles.'},color:'#c6aa6e'},
+  {id:'field-armor',kind:'armor',name:{zh:'巡行護甲',en:'Field armor'},description:{zh:'測試配裝與收藏展示，不提供付費戰力。',en:'Equipment and display fixture; no paid combat advantage.'},color:'#7da3ac'},
+  {id:'signal-tool',kind:'tool',name:{zh:'訊號裝置',en:'Signal tool'},description:{zh:'驗證第三個配裝欄位的本機道具。',en:'A local item for the third loadout slot.'},color:'#a1ad8b'},
+  {id:'ember-cup',kind:'trophy',name:{zh:'初征餘燼獎盃',en:'First expedition trophy'},description:{zh:'本機測試任務的紀念品；不是正式通關或 GOLD 獎勵。',en:'A local test mission keepsake, not a live achievement or GOLD reward.'},color:'#dcad63'},
+  {id:'crystal-trophy',kind:'trophy',name:{zh:'晶岩紀念章',en:'Crystal keepsake'},description:{zh:'本機收藏樣品，用於驗證替換與收回。',en:'A collection fixture for testing replacement and removal.'},color:'#80b6c6'},
+  {id:'fixture-nft',kind:'nft',name:{zh:'餘燼藏畫 #1',en:'Ember artwork #1'},description:{zh:'鏈 31337 的模擬持有資料；不是鏈上 Mint 或正式 NFT。',en:'Simulated ownership on chain 31337, not a minted or live NFT.'},color:'#b8a0c8'},
+];
+export const definition=(id:string)=>DEFINITIONS.find(d=>d.id===id);
+export const DISPLAY_SLOTS:readonly {id:DisplaySlot;kind:Kind;name:Label}[]=[
+  {id:'trophy-1',kind:'trophy',name:{zh:'上層左・戰利品',en:'Upper left · trophy'}},
+  {id:'trophy-2',kind:'trophy',name:{zh:'上層右・戰利品',en:'Upper right · trophy'}},
+  {id:'weapon-1',kind:'weapon',name:{zh:'中層左・武器',en:'Middle left · weapon'}},
+  {id:'weapon-2',kind:'weapon',name:{zh:'中層右・武器',en:'Middle right · weapon'}},
+  {id:'armor-1',kind:'armor',name:{zh:'下層左・護甲',en:'Lower left · armor'}},
+  {id:'nft-1',kind:'nft',name:{zh:'下層右・NFT 畫框',en:'Lower right · NFT frame'}},
+];
+export type Holding={id:string;definitionId:string;source:string;acquiredAt:number;nft?:{chainId:31337;contract:string;tokenId:string;state:NftState;checkedAt:number}};
+export type CollectionState={revision:number;items:Holding[];loadout:Record<EquipSlot,string|null>;displays:Record<DisplaySlot,string|null>};
+export type Snapshot=CollectionState&{wallet:string;fixture:string;home:{state:HomeState;size:'m'|'ms'|null};localOnly:true};
+export type Command={type:'equip';slot:EquipSlot;itemId:string|null}|{type:'display';slot:DisplaySlot;itemId:string|null}|{type:'claim-test-trophy'}|{type:'set-test-nft';state:NftState};
+export class CollectionError extends Error{code:string;status:number;constructor(code:string,status=400){super(code);this.code=code;this.status=status;}}
+const plain=(v:unknown):v is Record<string,unknown>=>!!v&&typeof v==='object'&&!Array.isArray(v);
+function exact(o:Record<string,unknown>,keys:string[]){if(Object.keys(o).sort().join('|')!==keys.sort().join('|'))throw new CollectionError('INVALID_COMMAND');}
+export function parseCommand(value:unknown):Command{
+  if(!plain(value))throw new CollectionError('INVALID_COMMAND');
+  if(value.type==='claim-test-trophy'){exact(value,['type']);return {type:value.type};}
+  if(value.type==='set-test-nft'){exact(value,['type','state']);if(!['owned','unavailable','transferred'].includes(String(value.state)))throw new CollectionError('INVALID_COMMAND');return {type:value.type,state:value.state as NftState};}
+  if(value.type==='equip'||value.type==='display'){
+    exact(value,['type','slot','itemId']);
+    if(value.itemId!==null&&(typeof value.itemId!=='string'||!/^[a-z0-9-]{1,80}$/.test(value.itemId)))throw new CollectionError('INVALID_COMMAND');
+    if(value.type==='equip'&&!['weapon','armor','tool'].includes(String(value.slot)))throw new CollectionError('INVALID_COMMAND');
+    if(value.type==='display'&&!DISPLAY_SLOTS.some(s=>s.id===value.slot))throw new CollectionError('INVALID_COMMAND');
+    return value as unknown as Command;
+  }
+  throw new CollectionError('INVALID_COMMAND');
+}
+export function usable(item:Holding){return !item.nft||item.nft.state==='owned';}
+export function shownItems(s:CollectionState,kind:'all'|Kind,query:string,history=false){
+  const q=query.trim().toLowerCase().slice(0,80);
+  return s.items.filter(i=>{const d=definition(i.definitionId);return d&&(history||i.nft?.state!=='transferred')&&(kind==='all'||d.kind===kind)&&`${d.name.zh} ${d.name.en}`.toLowerCase().includes(q);});
+}
+export function activeDisplays(s:Snapshot){return s.home.state==='eligible'?DISPLAY_SLOTS.flatMap(slot=>{const item=s.items.find(i=>i.id===s.displays[slot.id]);return item&&usable(item)?[{slot:slot.id,item,definition:definition(item.definitionId)!}]:[];}):[];}
+export function applyCommand(current:CollectionState,command:Command,home:HomeState,now:number):CollectionState{
+  const next=structuredClone(current);
+  if(command.type==='set-test-nft'){
+    const item=next.items.find(i=>i.nft);if(!item?.nft)throw new CollectionError('ITEM_NOT_FOUND',404);
+    item.nft.state=command.state;item.nft.checkedAt=now;
+    if(command.state==='transferred')for(const slot of DISPLAY_SLOTS)if(next.displays[slot.id]===item.id)next.displays[slot.id]=null;
+  }else if(command.type==='claim-test-trophy'){
+    if(!next.items.some(i=>i.source==='local-match-001'))next.items.push({id:'test-match-trophy',definitionId:'ember-cup',source:'local-match-001',acquiredAt:now});
+    else return current;
+  }else{
+    if(command.type==='display'&&home!=='eligible')throw new CollectionError(home==='none'?'HOME_REQUIRED':'HOME_UNAVAILABLE',403);
+    const item=command.itemId===null?null:next.items.find(i=>i.id===command.itemId);
+    if(command.itemId!==null&&(!item||!usable(item)))throw new CollectionError('ITEM_NOT_AVAILABLE',409);
+    if(item){
+      const kind=definition(item.definitionId)?.kind;
+      const expected=command.type==='equip'?command.slot:DISPLAY_SLOTS.find(s=>s.id===command.slot)?.kind;
+      if(kind!==expected)throw new CollectionError('INCOMPATIBLE_SLOT');
+    }
+    if(command.type==='equip')next.loadout[command.slot]=command.itemId;
+    else{
+      // Moving a unique object clears its previous display reference; inventory is never cloned.
+      if(command.itemId)for(const slot of DISPLAY_SLOTS)if(next.displays[slot.id]===command.itemId)next.displays[slot.id]=null;
+      next.displays[command.slot]=command.itemId;
+    }
+  }
+  next.revision++;return next;
+}
