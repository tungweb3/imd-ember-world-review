+import {useEffect,useLayoutEffect,useRef,useState} from 'react';
+import * as THREE from 'three';
+import {InteriorRoom} from '../interior/room.ts';
+import {collectionModels} from './displayModels.ts';
+import type {Snapshot} from './model.ts';
+
+export function CollectionRoom({snapshot,zh}:{snapshot:Snapshot;zh:boolean}){
+  const host=useRef<HTMLDivElement>(null),room=useRef<InteriorRoom|null>(null),latest=useRef(snapshot);latest.current=snapshot;
+  const [error,setError]=useState(false),[close,setClose]=useState(false),[draws,setDraws]=useState(0);
+  useLayoutEffect(()=>{
+    const target=host.current;if(!target||snapshot.home.state!=='eligible')return;
+    let renderer:THREE.WebGLRenderer|undefined,r:InteriorRoom|undefined,timer:ReturnType<typeof setInterval>|undefined;
+    try{
+      renderer=new THREE.WebGLRenderer({antialias:true,alpha:false,powerPreference:'low-power'});renderer.setPixelRatio(Math.min(devicePixelRatio,1.5));renderer.outputColorSpace=THREE.SRGBColorSpace;renderer.toneMapping=THREE.ACESFilmicToneMapping;
+      r=new InteriorRoom(renderer,target,{size:snapshot.home.size??'m',style:'lisbon',phone:innerWidth<760,reduced:matchMedia('(prefers-reduced-motion: reduce)').matches,zh,sky:()=>({weather:'sunny',mood:{rain:0,wind:0},preview:12})},{ready:()=>{},exit:()=>{},seat:()=>false,say:()=>{},changed:()=>{},hover:()=>{}});
+      room.current=r;r.setCollectionDisplay(collectionModels(latest.current));setError(false);
+      const obs=new ResizeObserver(()=>r?.invalidate());obs.observe(target);
+      timer=setInterval(()=>setDraws(r?.drawCalls??0),2000);
+      return()=>{obs.disconnect();if(timer)clearInterval(timer);room.current=null;r?.dispose();renderer?.dispose();renderer?.forceContextLoss();renderer?.domElement.remove();};
+    }catch{r?.dispose();renderer?.dispose();renderer?.domElement.remove();setError(true);}
+  },[snapshot.wallet,snapshot.home.state,snapshot.home.size]);
+  useEffect(()=>{room.current?.setCollectionDisplay(collectionModels(snapshot));},[snapshot.wallet,snapshot.revision,snapshot.home.state,snapshot.home.size]);
+  useEffect(()=>{room.current?.setLanguage(zh);},[zh]);
+  useEffect(()=>{room.current?.focusCollection(close);},[close,snapshot.wallet,snapshot.home.state]);
+  if(snapshot.home.state!=='eligible')return <div className="collection-no-home"><span aria-hidden="true">⌂</span><h2>{zh?'收藏仍在，住宅資格另行確認':'Your collection is safe'}</h2><p>{snapshot.home.state==='none'?(zh?'這個測試身分沒有符合資格的住宅；背包與配裝仍可使用。':'This fixture has no eligible home. Inventory and loadout remain available.'):(zh?'住宅資格暫時無法確認，展示操作暫停；這不代表沒有持有。':'Housing verification is unavailable. This does not mean you own nothing.')}</p></div>;
+  return <div className="collection-room"><div className="collection-room-canvas" ref={host} aria-label={zh?'原有住宅與收藏櫃 3D 預覽':'Existing home and collection cabinet in 3D'}/><div className="collection-room-controls"><button onClick={()=>setClose(!close)} aria-pressed={close}>{zh?(close?'看整個房間':'近看收藏櫃'):(close?'Whole room':'Inspect cabinet')}</button><span>{zh?'拖曳轉動・滾輪縮放':'Drag to orbit · scroll to zoom'}</span></div><p className="collection-room-caption">{zh?'沿用原住宅與家具；六個固定展示位在收藏櫃內。':'Original room and furniture; six fixed slots inside the cabinet.'}<small>{draws} draw calls</small></p>{error&&<p role="alert">{zh?'3D 暫時無法啟動，仍可使用右側收藏清單。':'3D is unavailable. The collection list remains usable.'}</p>}</div>;
+}
diff --git a/src/world/collection/client.ts b/src/world/collection/client.ts
new file mode 100644
index 0000000..997e0ac
--- /dev/null
+++ b/src/world/collection/client.ts
@@ -0,0 +1,35 @@
+import type {Command,Snapshot} from './model.ts';
+export type ClientState={snapshot:Snapshot|null;busy:boolean;loading:boolean;error:string|null};
+export class CollectionClient{
+  state:ClientState={snapshot:null,busy:false,loading:true,error:null};
+  private listeners=new Set<()=>void>();private epoch=0;private read=0;private disposed=false;
+  private transport:typeof fetch;
+  constructor(transport:typeof fetch=fetch){this.transport=transport;}
+  subscribe=(fn:()=>void)=>{this.listeners.add(fn);return()=>{this.listeners.delete(fn);};};
+  getSnapshot=()=>this.state;
+  private set(value:Partial<ClientState>){if(this.disposed)return;this.state={...this.state,...value};for(const fn of this.listeners)fn();}
+  private async request(path:string,body?:unknown):Promise<Snapshot>{
+    const transport=this.transport;
+    const r=await transport('/api/local-collection/'+path,{credentials:'same-origin',...(body===undefined?{}:{method:'POST',headers:{'Content-Type':'application/json','X-Collection-Preview':'1'},body:JSON.stringify(body)})});
+    const data=await r.json();if(!r.ok)throw new Error(String(data.error??'LOCAL_UNAVAILABLE'));
+    if(data.localOnly!==true||!Array.isArray(data.items)||!Number.isSafeInteger(data.revision))throw new Error('INVALID_RESPONSE');return data;
+  }
+  async refresh(){
+    const epoch=this.epoch,read=++this.read;
+    try{const snapshot=await this.request('state');if(epoch!==this.epoch||read!==this.read||this.state.busy)return;this.set({snapshot,loading:false,error:null});}
+    catch(e){if(epoch!==this.epoch||read!==this.read||this.state.busy)return;const error=(e as Error).message;this.set({loading:false,error,snapshot:error==='LOCAL_SESSION_REQUIRED'?null:this.state.snapshot});}
+  }
+  async switchFixture(fixture:string){
+    if(this.state.busy)return;const epoch=++this.epoch;this.read++;this.set({busy:true,loading:true,error:null,snapshot:null});
+    try{const snapshot=await this.request('session',{fixture});if(epoch===this.epoch)this.set({snapshot,loading:false});}
+    catch(e){if(epoch===this.epoch)this.set({error:(e as Error).message,loading:false});}
+    finally{if(epoch===this.epoch)this.set({busy:false});}
+  }
+  async command(command:Command){
+    const snapshot=this.state.snapshot;if(!snapshot||this.state.busy)return;const epoch=this.epoch;this.read++;this.set({busy:true,error:null});
+    try{const result=await this.request('command',{revision:snapshot.revision,command});if(epoch===this.epoch)this.set({snapshot:result});}
+    catch(e){if(epoch===this.epoch){const error=(e as Error).message;this.set({error,snapshot:error==='LOCAL_SESSION_REQUIRED'?null:this.state.snapshot});}}
+    finally{if(epoch===this.epoch)this.set({busy:false});}
+  }
+  dispose(){this.disposed=true;this.epoch++;this.listeners.clear();}
+}
