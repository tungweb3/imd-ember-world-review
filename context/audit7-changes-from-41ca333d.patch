+import {randomBytes} from 'node:crypto';
+import {CollectionError,parseCommand} from '../src/world/collection/model.ts';
+import {fixtureOf,type Fixture,type LocalCollectionStore} from './collection-local-store.ts';
+
+const BASE='/api/local-collection',COOKIE='ember_collection_preview';
+const loopback=(host:string)=>['127.0.0.1','localhost','[::1]'].includes(host);
+export function createCollectionLocalApi(store:LocalCollectionStore,now=Date.now){
+  const sessions=new Map<string,{fixture:Fixture;expires:number}>();
+  return async(request:Request):Promise<Response|null>=>{
+    const url=new URL(request.url);if(!url.pathname.startsWith(BASE+'/'))return null;
+    const json=(body:unknown,status=200,headers:Record<string,string>={})=>new Response(JSON.stringify(body),{status,headers:{'Content-Type':'application/json','Cache-Control':'no-store','X-Content-Type-Options':'nosniff',...headers}});
+    if(!loopback(url.hostname))return json({error:'LOCAL_ONLY'},403);
+    try{
+      const write=request.method==='POST';
+      if(!write&&request.method!=='GET')return json({error:'METHOD_NOT_ALLOWED'},405);
+      if(write&&(request.headers.get('Origin')!==url.origin||request.headers.get('X-Collection-Preview')!=='1'||!request.headers.get('Content-Type')?.startsWith('application/json')))return json({error:'ORIGIN_REQUIRED'},403);
+      let body:Record<string,unknown>={};
+      if(write){const raw=await request.text();if(raw.length>4096)return json({error:'BODY_TOO_LARGE'},413);try{body=JSON.parse(raw);}catch{return json({error:'INVALID_JSON'},400);}if(!body||typeof body!=='object'||Array.isArray(body))throw new CollectionError('INVALID_COMMAND');}
+      // Sessions cannot grow without bound during repeated fixture testing.
+      for(const [key,s] of sessions)if(s.expires<=now())sessions.delete(key);
+      const token=request.headers.get('Cookie')?.split(';').map(s=>s.trim()).find(s=>s.startsWith(COOKIE+'='))?.slice(COOKIE.length+1),session=token?sessions.get(token):null;
+      if(write&&url.pathname===BASE+'/session'){
+        if(Object.keys(body).join()!=='fixture')throw new CollectionError('INVALID_COMMAND');
+        const fixture=fixtureOf(body.fixture);if(sessions.size>=128)return json({error:'LOCAL_SESSION_LIMIT'},429);
+        const id=randomBytes(24).toString('hex');sessions.set(id,{fixture,expires:now()+7_200_000});if(token)sessions.delete(token);
+        return json(store.read(fixture),200,{'Set-Cookie':`${COOKIE}=${id}; HttpOnly; SameSite=Strict; Path=${BASE}; Max-Age=7200`});
+      }
+      if(!session)return json({error:'LOCAL_SESSION_REQUIRED'},401);
+      if(!write&&url.pathname===BASE+'/state')return json(store.read(session.fixture));
+      if(write&&url.pathname===BASE+'/command'){
+        if(Object.keys(body).sort().join()!=='command,revision')throw new CollectionError('INVALID_COMMAND');
+        return json(store.command(session.fixture,body.revision as number,parseCommand(body.command)));
+      }
+      return json({error:'NOT_FOUND'},404);
+    }catch(e){return json({error:e instanceof CollectionError?e.code:'LOCAL_STORE_UNAVAILABLE'},e instanceof CollectionError?e.status:503);}
+  };
+}
