+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {mkdtempSync,rmSync,readFileSync} from 'node:fs';
+import {tmpdir} from 'node:os';
+import {join} from 'node:path';
+import {fileURLToPath} from 'node:url';
+import {build} from 'vite';
+test('a real production build excludes the fixture app and local API even when the local preview flag is enabled',async()=>{
+  const root=fileURLToPath(new URL('..',import.meta.url)),out=mkdtempSync(join(tmpdir(),'collection-boundary-'));
+  const before=process.env.EMBER_COLLECTION_LOCAL;process.env.EMBER_COLLECTION_LOCAL='1';
+  try{
+    const result=await build({root,logLevel:'silent',build:{outDir:out,emptyOutDir:true,license:false}}),outputs=(Array.isArray(result)?result:[result]).flatMap(r=>r.output);
+    const chunks=outputs.filter(o=>o.type==='chunk');assert.ok(chunks.length>0);
+    for(const c of chunks)for(const marker of ['api/local-collection','Choose a local test identity','本機測試情境','local-match-001'])assert.ok(!c.code.includes(marker),`${c.fileName} leaked ${marker}`);
+    assert.ok(!outputs.some(o=>/CollectionLocalApp|CollectionRoom/.test(o.fileName)),'local-only pages must not create public chunks');
+    const html=readFileSync(join(out,'index.html'),'utf8');assert.ok(!html.includes('CollectionLocalApp'));
+  }finally{if(before===undefined)delete process.env.EMBER_COLLECTION_LOCAL;else process.env.EMBER_COLLECTION_LOCAL=before;rmSync(out,{recursive:true,force:true});}
+});
