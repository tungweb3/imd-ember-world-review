+import * as THREE from 'three';
+import {activeDisplays,type Snapshot,type Kind} from './model.ts';
+
+// Six bounded, static low-poly fixtures. No remote media, animated rigs or new lights.
+function model(kind:Kind,color:string){
+  const root=new THREE.Group(),metal=new THREE.MeshStandardMaterial({color,metalness:.55,roughness:.38}),dark=new THREE.MeshStandardMaterial({color:'#403b33',roughness:.7});
+  const add=(g:THREE.BufferGeometry,m:THREE.Material,x=0,y=0,z=0)=>{const mesh=new THREE.Mesh(g,m);mesh.position.set(x,y,z);root.add(mesh);return mesh;};
+  if(kind==='trophy'){
+    add(new THREE.CylinderGeometry(.055,.075,.04,10),dark,0,.02);add(new THREE.CylinderGeometry(.018,.025,.09,8),metal,0,.075);
+    add(new THREE.ConeGeometry(.085,.13,8),metal,0,.16).rotation.z=Math.PI;
+    add(new THREE.TorusGeometry(.065,.012,4,12),metal,-.065,.17).scale.set(.55,.7,1);add(new THREE.TorusGeometry(.065,.012,4,12),metal,.065,.17).scale.set(.55,.7,1);
+  }else if(kind==='weapon'){
+    add(new THREE.BoxGeometry(.23,.055,.045),metal,0,.11);add(new THREE.CylinderGeometry(.012,.012,.12,8),dark,.16,.11).rotation.z=Math.PI/2;
+    add(new THREE.BoxGeometry(.04,.07,.035),dark,-.03,.055).rotation.z=-.25;add(new THREE.BoxGeometry(.07,.045,.035),dark,-.14,.1);
+    root.rotation.z=.28;root.position.y=.04;
+  }else if(kind==='armor'){
+    const shield=add(new THREE.CylinderGeometry(.085,.055,.13,5),metal,0,.13);shield.scale.set(1,1,.35);add(new THREE.BoxGeometry(.11,.05,.045),metal,0,.22);add(new THREE.BoxGeometry(.085,.04,.06),dark,0,.035);
+  }else{
+    add(new THREE.BoxGeometry(.23,.25,.025),metal,0,.14);add(new THREE.PlaneGeometry(.185,.2),dark,0,.14,.014);
+    add(new THREE.OctahedronGeometry(.061),metal,0,.145,.03);add(new THREE.BoxGeometry(.14,.013,.01),metal,0,.06,.031);
+  }
+  return root;
+}
+export function collectionModels(snapshot:Snapshot){
+  const root=new THREE.Group();root.name='collection-displays';
+  for(const d of activeDisplays(snapshot)){
+    const left=d.slot==='trophy-1'||d.slot==='weapon-1'||d.slot==='armor-1',row=d.slot.startsWith('trophy')?1.505:d.slot.startsWith('weapon')?1.185:.865;
+    const item=model(d.definition.kind,d.definition.color);item.name='collection:'+d.slot;item.position.x=left?-.235:.235;item.position.y+=row;item.position.z=.12;root.add(item);
+  }
+  return root;
+}
diff --git a/src/world/collection/model.ts b/src/world/collection/model.ts
