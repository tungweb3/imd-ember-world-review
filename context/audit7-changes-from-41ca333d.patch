+const store=()=>new LocalCollectionStore(':memory:',()=>1_000_000);
+const move=(s,fixture,command)=>s.command(fixture,s.read(fixture).revision,command);
+
+test('one holding can be equipped and displayed; moving/removing display never grants another item',()=>{
+  const s=store();try{
+    const n=s.read('owner').items.length;
+    move(s,'owner',{type:'equip',slot:'weapon',itemId:'starter-rifle'});
+    move(s,'owner',{type:'display',slot:'weapon-1',itemId:'starter-rifle'});
+    move(s,'owner',{type:'display',slot:'weapon-2',itemId:'starter-rifle'});
+    let a=s.read('owner');assert.equal(a.loadout.weapon,'starter-rifle');assert.equal(a.displays['weapon-1'],null);assert.equal(a.displays['weapon-2'],'starter-rifle');assert.equal(a.items.length,n);
+    move(s,'owner',{type:'display',slot:'weapon-2',itemId:null});a=s.read('owner');assert.equal(a.loadout.weapon,'starter-rifle');assert.equal(a.items.length,n);
+  }finally{s.close();}
+});
+test('server test mission has one stable grant even when claimed repeatedly',()=>{
+  const s=store();try{for(let i=0;i<10;i++)move(s,'owner',{type:'claim-test-trophy'});const a=s.read('owner');assert.equal(a.items.filter(i=>i.source==='local-match-001').length,1);assert.equal(a.revision,1);}finally{s.close();}
+});
+test('a second database connection rejects stale revisions rather than losing another tab’s update',()=>{
+  const dir=mkdtempSync(join(tmpdir(),'collection-race-')),path=join(dir,'state.sqlite'),a=new LocalCollectionStore(path),b=new LocalCollectionStore(path);
+  try{const before=a.read('owner');b.command('owner',before.revision,{type:'equip',slot:'armor',itemId:'starter-armor'});assert.throws(()=>a.command('owner',before.revision,{type:'equip',slot:'weapon',itemId:'starter-rifle'}),e=>e.code==='REVISION_CONFLICT');const now=a.read('owner');assert.equal(now.loadout.armor,'starter-armor');assert.equal(now.loadout.weapon,null);assert.equal(now.revision,1);}finally{a.close();b.close();rmSync(dir,{recursive:true,force:true});}
+});
+test('inventory, loadout and display survive closing and reopening the local database',()=>{
+  const dir=mkdtempSync(join(tmpdir(),'collection-save-')),path=join(dir,'state.sqlite');let s=new LocalCollectionStore(path);
+  try{move(s,'owner',{type:'claim-test-trophy'});move(s,'owner',{type:'equip',slot:'tool',itemId:'starter-tool'});move(s,'owner',{type:'display',slot:'trophy-1',itemId:'test-match-trophy'});const before=s.read('owner');s.close();s=new LocalCollectionStore(path);assert.deepEqual(s.read('owner'),before);}finally{s.close();rmSync(dir,{recursive:true,force:true});}
+});
+test('separate authenticated fixture accounts never share equipment or earned items',()=>{
+  const s=store();try{move(s,'owner',{type:'claim-test-trophy'});move(s,'owner',{type:'equip',slot:'weapon',itemId:'starter-rifle'});const b=s.read('second');assert.equal(b.items.some(i=>i.source==='local-match-001'),false);assert.equal(b.loadout.weapon,null);assert.notEqual(b.wallet,s.read('owner').wallet);assert.throws(()=>move(s,'second',{type:'display',slot:'trophy-1',itemId:'test-match-trophy'}),e=>e.code==='ITEM_NOT_AVAILABLE');}finally{s.close();}
+});
+test('no housing entitlement or unavailable housing never becomes a free home; the bag still works',()=>{
+  const s=store();try{for(const fixture of ['nohome','unavailable']){const start=s.read(fixture);move(s,fixture,{type:'equip',slot:'weapon',itemId:'starter-rifle'});assert.throws(()=>move(s,fixture,{type:'display',slot:'weapon-1',itemId:'starter-rifle'}),e=>e.code===(fixture==='nohome'?'HOME_REQUIRED':'HOME_UNAVAILABLE'));assert.equal(s.read(fixture).items.length,start.items.length);assert.deepEqual(activeDisplays(s.read(fixture)),[]);assert.equal(s.read(fixture).home.size,null);}}finally{s.close();}
+});
