+import {DatabaseSync} from 'node:sqlite';
+import {CollectionError,applyCommand,type CollectionState,type Command,type Snapshot,type HomeState} from '../src/world/collection/model.ts';
+
+// Only fictitious identities. These are not World sessions or claims to on-chain wallet control.
+export const FIXTURES={
+  owner:{wallet:'0x'+'11'.repeat(20),home:'eligible',size:'m'},
+  second:{wallet:'0x'+'22'.repeat(20),home:'eligible',size:'ms'},
+  nohome:{wallet:'0x'+'33'.repeat(20),home:'none',size:null},
+  unavailable:{wallet:'0x'+'44'.repeat(20),home:'unavailable',size:null},
+} as const;
+export type Fixture=keyof typeof FIXTURES;
+export function fixtureOf(s:unknown):Fixture{if(typeof s!=='string'||!Object.hasOwn(FIXTURES,s))throw new CollectionError('UNKNOWN_FIXTURE');return s as Fixture;}
+export function starterState(now:number):CollectionState{
+  return {revision:0,items:[
+    {id:'starter-rifle',definitionId:'training-rifle',source:'local-starter',acquiredAt:now},
+    {id:'starter-armor',definitionId:'field-armor',source:'local-starter',acquiredAt:now},
+    {id:'starter-tool',definitionId:'signal-tool',source:'local-starter',acquiredAt:now},
+    {id:'starter-keepsake',definitionId:'crystal-trophy',source:'local-fixture',acquiredAt:now},
+    {id:'test-nft-1',definitionId:'fixture-nft',source:'local-nft-fixture',acquiredAt:now,nft:{chainId:31337,contract:'0x'+'55'.repeat(20),tokenId:'1',state:'owned',checkedAt:now}},
+  ],loadout:{weapon:null,armor:null,tool:null},displays:{'trophy-1':null,'trophy-2':null,'weapon-1':null,'weapon-2':null,'armor-1':null,'nft-1':null}};
+}
+export class LocalCollectionStore{
+  readonly db:DatabaseSync;
+  private now:()=>number;
+  constructor(path:string,now=Date.now){
+    this.now=now;
+    this.db=new DatabaseSync(path);this.db.exec('PRAGMA busy_timeout=5000; PRAGMA journal_mode=WAL; CREATE TABLE IF NOT EXISTS local_collections(wallet TEXT PRIMARY KEY, state TEXT NOT NULL);');
+  }
+  read(fixture:Fixture):Snapshot{
+    const f=FIXTURES[fixture],row=this.db.prepare('SELECT state FROM local_collections WHERE wallet=?').get(f.wallet);
+    if(!row){this.db.prepare('INSERT OR IGNORE INTO local_collections(wallet,state) VALUES(?,?)').run(f.wallet,JSON.stringify(starterState(this.now())));return this.read(fixture);}
+    return {...JSON.parse(String(row.state)) as CollectionState,wallet:f.wallet,fixture,home:{state:f.home as HomeState,size:f.size},localOnly:true};
+  }
+  command(fixture:Fixture,revision:number,command:Command):Snapshot{
+    if(!Number.isSafeInteger(revision)||revision<0)throw new CollectionError('INVALID_REVISION');
+    this.db.exec('BEGIN IMMEDIATE');
+    try{
+      const before=this.read(fixture);if(before.revision!==revision)throw new CollectionError('REVISION_CONFLICT',409);
+      const core:CollectionState={revision:before.revision,items:before.items,loadout:before.loadout,displays:before.displays};
+      const next=applyCommand(core,command,before.home.state,this.now());
+      this.db.prepare('UPDATE local_collections SET state=? WHERE wallet=?').run(JSON.stringify(next),before.wallet);
+      this.db.exec('COMMIT');return this.read(fixture);
+    }catch(e){this.db.exec('ROLLBACK');throw e;}
+  }
+  close(){this.db.close();}
+}
