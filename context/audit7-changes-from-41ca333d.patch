+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {CollectionClient} from '../src/world/collection/client.ts';
+import {starterState} from '../server/collection-local-store.ts';
+const snap=(wallet='A',revision=0)=>({...starterState(100),revision,wallet,fixture:'owner',home:{state:'eligible',size:'m'},localOnly:true});
+const response=s=>new Response(JSON.stringify(s));
+const deferred=()=>{let resolve;const promise=new Promise(r=>resolve=r);return {promise,resolve};};
+test('browser fetch is invoked without binding the collection client as its Window receiver',async()=>{
+  const c=new CollectionClient(async function(){assert.equal(this,undefined);return response(snap());});await c.refresh();assert.equal(c.state.error,null);assert.equal(c.state.snapshot.wallet,'A');
+});
+
+test('a read from the old account cannot overwrite a completed fixture switch',async()=>{
+  const old=deferred(),c=new CollectionClient(async(path)=>path.endsWith('/state')?old.promise:response(snap('B')));
+  const a=c.refresh();await c.switchFixture('second');old.resolve(response(snap('A')));await a;assert.equal(c.state.snapshot.wallet,'B');
+});
+test('late reads cannot roll back a successful mutation or show the wrong saved version',async()=>{
+  const late=deferred();let reads=0;const c=new CollectionClient(async(path)=>path.endsWith('/command')?response(snap('A',1)):++reads===1?response(snap()):late.promise);
+  await c.refresh();const slow=c.refresh();await c.command({type:'claim-test-trophy'});late.resolve(response(snap('A',0)));await slow;assert.equal(c.state.snapshot.revision,1);
+});
+test('only the newest parallel read is applied',async()=>{
+  const a=deferred(),b=deferred();let n=0;const c=new CollectionClient(async()=>++n===1?a.promise:b.promise);const first=c.refresh(),second=c.refresh();b.resolve(response(snap('B',8)));await second;a.resolve(response(snap('A',1)));await first;assert.equal(c.state.snapshot.wallet,'B');assert.equal(c.state.snapshot.revision,8);
+});
+test('a revision conflict preserves the visible version until an explicit refresh and never resends a mutation',async()=>{
+  let writes=0,revision=0;const c=new CollectionClient(async(path)=>{if(path.endsWith('/command')){writes++;revision=2;return new Response(JSON.stringify({error:'REVISION_CONFLICT'}),{status:409});}return response(snap('A',revision));});
+  await c.refresh();await c.command({type:'claim-test-trophy'});assert.equal(c.state.error,'REVISION_CONFLICT');assert.equal(c.state.snapshot.revision,0);assert.equal(writes,1);await c.refresh();assert.equal(c.state.snapshot.revision,2);assert.equal(writes,1);assert.equal(c.state.error,null);
+});
+test('double clicks and fixture switches during a write cannot submit competing session changes',async()=>{
+  const wait=deferred();let writes=0,switches=0;const c=new CollectionClient(async(path)=>{if(path.endsWith('/command')){writes++;return wait.promise;}if(path.endsWith('/session'))switches++;return response(snap());});await c.refresh();const work=c.command({type:'claim-test-trophy'});await c.command({type:'claim-test-trophy'});await c.switchFixture('second');assert.equal(writes,1);assert.equal(switches,0);wait.resolve(response(snap('A',1)));await work;assert.equal(c.state.busy,false);
+});
+test('expired local session clears private collection; network failure keeps evidence and offers retry',async()=>{
+  let mode='good';const c=new CollectionClient(async()=>{if(mode==='network')throw new Error('offline');if(mode==='expired')return new Response(JSON.stringify({error:'LOCAL_SESSION_REQUIRED'}),{status:401});return response(snap());});await c.refresh();mode='network';await c.refresh();assert.equal(c.state.snapshot.wallet,'A');assert.equal(c.state.error,'offline');mode='expired';await c.refresh();assert.equal(c.state.snapshot,null);assert.equal(c.state.error,'LOCAL_SESSION_REQUIRED');
+});
+test('disposed clients ignore delayed results and release subscriptions',async()=>{
+  const wait=deferred(),c=new CollectionClient(async()=>wait.promise);let calls=0;c.subscribe(()=>calls++);const p=c.refresh();c.dispose();wait.resolve(response(snap()));await p;assert.equal(c.state.snapshot,null);assert.equal(calls,0);
+});
