+  const s=new LocalCollectionStore(':memory:');try{
+    let a=s.read('owner');a=s.command('owner',a.revision,{type:'claim-test-trophy'});
+    const values=['starter-keepsake','test-match-trophy','starter-rifle',null,'starter-armor','test-nft-1'];
+    for(let i=0;i<DISPLAY_SLOTS.length;i++)if(values[i])a=s.command('owner',a.revision,{type:'display',slot:DISPLAY_SLOTS[i].id,itemId:values[i]});
+    const root=collectionModels(a);assert.equal(root.children.length,5);assert.ok(root.getObjectByName('collection:nft-1').position.x>0);assert.ok(root.getObjectByName('collection:armor-1').position.x<0);let triangles=0;const materials=new Set();root.traverse(o=>{assert.ok(!o.isLight);if(o.isMesh){triangles+=(o.geometry.index?.count??o.geometry.attributes.position.count)/3;assert.equal(o.material.map,null);materials.add(o.material);assert.ok(!o.isSkinnedMesh);}});assert.ok(triangles<2500,triangles);assert.ok(materials.size<=10);for(const child of root.children){assert.ok(Math.abs(child.position.x)<.48);assert.ok(child.position.y>=.84&&child.position.y<=1.6);}
