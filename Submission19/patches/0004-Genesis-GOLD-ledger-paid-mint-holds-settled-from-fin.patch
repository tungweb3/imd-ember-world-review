+ let status=row.state;
+ if(row.state==='held'){const r=await reconcileHeldMintGold(db,reader(d,{transactionHash:q.transactionHash as string|undefined}),nowMs,{orderId:row.id});status=r.outcomes[0]?.status??'pending';}
