+/** The game sees a stable pseudonym and no part of the wallet address. It is an HMAC under a Worker secret, so it cannot be
+ * computed from an address list. The key must never be rotated: every subject id would change. */
+export async function squeekSubject(subjectKey:string,address:string){
+ const key=await crypto.subtle.importKey('raw',new TextEncoder().encode(subjectKey),{name:'HMAC',hash:'SHA-256'},false,['sign']);
+ const mac=new Uint8Array(await crypto.subtle.sign('HMAC',key,new TextEncoder().encode('squeek-subject-v1:'+address.toLowerCase())));
+ return 'sq_'+[...mac].map(b=>b.toString(16).padStart(2,'0')).join('').slice(0,40);
+}
 
