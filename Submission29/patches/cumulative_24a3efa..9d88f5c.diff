+  WHERE t.token_hash=?1 AND t.revoked_at IS NULL AND t.created_at<=?2 AND t.expires_at>?2 AND s.revoked_at IS NULL AND s.expires_at>?2`).bind(hash,now).first<{address:string;expires_at:number}>();
