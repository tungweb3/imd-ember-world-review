index cb63d35..bfd9f02 100644
--- a/integrations/celestao/celestao_world/paid.py
+++ b/integrations/celestao/celestao_world/paid.py
@@ -27,6 +27,13 @@ class PrepareRequest(BaseModel):
 
 def install(app,settings,vault,world,processor,clock,checked,still_current,headers):
     tasks=set();app.state.delivery_tasks=tasks;active={}
+    def start(ident,value,payload):
+        # A request the page must not repeat as it is: not a storage outage, so no 503 that invites a retry.
+        try:return vault.prepare(ident.wallet,value.requestId,value.system,payload,True,clock())
+        except VaultError as exc:
+            if str(exc)=='IDEMPOTENCY_CONFLICT':raise HTTPException(409,'IDEMPOTENCY_CONFLICT') from None
+            if str(exc) in ('INVALID_REQUEST','INPUT_TOO_LARGE','DOCUMENT_TOO_LARGE','SAVE_CONSENT_REQUIRED'):raise HTTPException(422,str(exc)) from None
+            raise
     @app.post('/api/world/runs')
     async def prepare(value:PrepareRequest,ident=Depends(checked)):
         if not settings.paid_enabled:raise HTTPException(503,'FEATURE_PAUSED')
@@ -36,7 +43,7 @@ def install(app,settings,vault,world,processor,clock,checked,still_current,heade
         except NativeInputError as exc:raise HTTPException(422,str(exc)) from None
         except NativeUnavailable:raise HTTPException(503,'ENGINE_UNAVAILABLE') from None
         still_current(ident)
-        run=vault.prepare(ident.wallet,value.requestId,value.system,payload,True,clock())
+        run=start(ident,value,payload)
         for _ in range(LAPSED_RUN_TRIES):
             try:checkout=await world.prepare_checkout(ident.grant,run)
             except (AuthDenied,BridgeUnavailable) as error:
@@ -49,7 +56,7 @@ def install(app,settings,vault,world,processor,clock,checked,still_current,heade
             try:vault.retire_lapsed(ident.wallet,run['id'])
             except Missing:pass
             except VaultError:raise HTTPException(503,'CHECKOUT_UNAVAILABLE') from None
-            run=vault.prepare(ident.wallet,value.requestId,value.system,payload,True,clock())
+            run=start(ident,value,payload)
         else:raise HTTPException(503,'CHECKOUT_UNAVAILABLE')
         # Checked first: a run whose buyer got no link goes at the end of its window.
         still_current(ident)
diff --git a/integrations/celestao/celestao_world/vault.py b/integrations/celestao/celestao_world/vault.py
index 2b2bb13..7824b11 100644
--- a/integrations/celestao/celestao_world/vault.py
+++ b/integrations/celestao/celestao_world/vault.py
@@ -108,7 +108,11 @@ class Vault:
             old=self.db.execute('SELECT * FROM runs WHERE owner=? AND request_id=?',(owner,request_id)).fetchone()
             if old:
                 if old['system']!=system or old['input_hash']!=digest: raise VaultError('IDEMPOTENCY_CONFLICT')
-            else:
+                if old['state']=='failed':
+                    # Refunded, so the page's kept request may buy again. The old row keeps its id and order for a late delivery or refund.
+                    self.db.execute("UPDATE runs SET request_id=request_id||'~'||id WHERE id=?",(old['id'],))
+                    old=None
+            if not old:
                 # A reload loses the page's request id. The same reading keeps its run, and so its one World order, so it cannot be paid for twice.
                 # A failed run was refunded, so that reading can be bought again. A retired run that did get an order still counts.
                 old=self.db.execute("SELECT * FROM runs WHERE owner=? AND system=? AND input_hash=? AND state<>'failed' AND (retired IS NULL OR order_id IS NOT NULL) ORDER BY state='complete' DESC,order_id IS NOT NULL DESC,created_ms DESC,id LIMIT 1",(owner,system,digest)).fetchone()
