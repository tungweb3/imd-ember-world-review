-  }catch(e){p.textContent=errorText(e);}
+   else{p.textContent=run.state==='cleared'?say('這筆解讀沒有完成，出生資料已依保存期限清除。如果有付款，付款和退款紀錄請到 World 原始訂單查詢。','This reading did not complete, and its birth details were cleared after the retention period. If you paid, check the original World order for payment and refund records.'):run.state==='failed'?say('此筆解讀未完成，請至 World 查詢原單退款。','This reading did not complete. Check the original refund in World.'):run.state==='working'?say('已付款，報告正在產生，通常約 1–3 分鐘；此頁會自動更新，不需另建新單。','Paid. Your report is being prepared, usually in about 1–3 minutes. This page updates by itself; do not create another order.'):say('這筆解讀還沒開始產生。如果已在 World 付款，通常約 1–3 分鐘內會開始；請查詢原始訂單，不需另建新單。','This reading has not started yet. If you paid in World, it usually starts within 1–3 minutes. Check its original order; do not create another.');controls();}
+   if(['prepared','working'].includes(run.state))poll();
+  }catch(e){p.textContent=errorText(e);const code=e?.message;if(live()&&code!=='AUTH_REQUIRED'&&code!=='CONTEXT_CHANGED'){controls();if(code!=='NOT_FOUND')poll();}}
  }
