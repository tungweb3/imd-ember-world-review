  }
  async function showRun(host,id){const old=runPolls.get(host);if(old?.timer)clearTimeout(old.timer);const request={};runPolls.set(host,request);const p=node('p',say('正在查詢原始解讀…','Checking original reading…'));p.role='status';host.append(p);const generation=epoch;
+  const live=()=>generation===epoch&&host.isConnected&&runPolls.get(host)===request;
+  const controls=()=>{const link=node('a',say('查詢 World 原始訂單','Check original World order'),'btn secondary small');link.href=catalog.worldOrigin+'/fortune-checkout/?run='+id+'&lang='+lang;link.referrerPolicy='no-referrer';host.append(link,button(say('重新查詢','Check again'),()=>{host.replaceChildren();void showRun(host,id);}));};
+  const poll=()=>{request.timer=setTimeout(()=>{if(live()&&document.visibilityState==='visible'){host.replaceChildren();void showRun(host,id);}},5000);};
   try{const run=await api('/api/world/runs/'+id);if(generation!==epoch||!host.isConnected||runPolls.get(host)!==request)return;
    if(run.state==='complete'&&opaque(run.recordId)){p.textContent=say('原始報告已保存，不需再次付款。','Your original report is saved. No further payment is needed.');host.append(button(say('開啟原始報告','Open original report'),()=>void openRecord(run.recordId).catch(e=>p.textContent=errorText(e))));const list=document.getElementById('world-wallet-records');if(list)void collection(list);}
-   else{p.textContent=run.state==='cleared'?say('這筆解讀沒有完成，出生資料已依保存期限清除。如果有付款，付款和退款紀錄請到 World 原始訂單查詢。','This reading did not complete, and its birth details were cleared after the retention period. If you paid, check the original World order for payment and refund records.'):run.state==='failed'?say('此筆解讀未完成，請至 World 查詢原單退款。','This reading did not complete. Check the original refund in World.'):run.state==='working'?say('已付款，報告正在產生，通常約 1–2 分鐘；此頁會自動更新，不需另建新單。','Paid. Your report is being prepared, usually in about 1–2 minutes. This page updates by itself; do not create another order.'):say('這筆解讀還沒開始產生。如果已在 World 付款，通常約 1–2 分鐘內會開始；請查詢原始訂單，不需另建新單。','This reading has not started yet. If you paid in World, it usually starts within 1–2 minutes. Check its original order; do not create another.');const link=node('a',say('查詢 World 原始訂單','Check original World order'),'btn secondary small');link.href=catalog.worldOrigin+'/fortune-checkout/?run='+id+'&lang='+lang;link.referrerPolicy='no-referrer';host.append(link,button(say('重新查詢','Check again'),()=>{host.replaceChildren();void showRun(host,id);}));}
