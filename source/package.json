{
  "name": "stickember-imd-world",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "test:review": "node scripts/review-tests.mjs",
    "edge:dev": "vite build && wrangler dev --port 8791",
    "edge:dry-run": "vite build && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "deploy": "node scripts/deploy.mjs",
    "deploy:dry-run": "node scripts/deploy.mjs --dry-run",
    "deploy:evidence": "node scripts/deploy-evidence.mjs"
  },
  "overrides": {
    "ws": "^8.21.0",
    "undici": "7.29.1"
  },
  "dependencies": {
    "@noble/curves": "1.9.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "0.186.1",
    "viem": "2.56.9"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "wrangler": "4.143.0"
  }
}
